# Скопируйте в .env и заполните. Файл .env не коммитится.

# backtest | paper | live
TB_MODE=paper
TB_LOG_LEVEL=INFO
TB_LOG_JSON=true

POSTGRES_PASSWORD=change-me

# Bybit: для testnet создайте ключи на testnet.bybit.com.
# Права ключа: только торговля (без вывода), IP-whitelist вашего сервера.
TB_BYBIT_TESTNET=true
TB_BYBIT_API_KEY=
TB_BYBIT_API_SECRET=

# Панель: длинная случайная строка (например, `openssl rand -hex 32`)
TB_JWT_SECRET=
# Ключ Fernet для шифрования API-ключей в БД:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TB_MASTER_KEY=

# Акции США через Alpaca (https://alpaca.markets, есть бесплатный paper-счёт).
# В режиме paper бот всегда использует paper-счёт; для live нужно явно TB_ALPACA_PAPER=false.
TB_ALPACA_API_KEY=
TB_ALPACA_API_SECRET=
TB_ALPACA_PAPER=true

TB_TELEGRAM_BOT_TOKEN=
TB_TELEGRAM_CHAT_ID=
